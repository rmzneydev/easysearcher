<Window x:Class="EasySearcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasySearcher.App"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="EasySearcher" Height="640" Width="1300" Icon="Assets/EasySearcher.ico"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=QueryBox}">
    <Window.Resources>
        <local:SizeConverter x:Key="SizeConverter" />

        <!-- Vistas de iconos: cuadricula virtualizada (solo crea los elementos visibles) -->
        <ItemsPanelTemplate x:Key="MediumIconsPanel">
            <vwp:VirtualizingWrapPanel ItemSize="120,150" SpacingMode="Uniform" StretchItems="False" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="LargeIconsPanel">
            <vwp:VirtualizingWrapPanel ItemSize="216,250" SpacingMode="Uniform" StretchItems="False" />
        </ItemsPanelTemplate>

        <!-- Mientras llega la miniatura (o si no hay) se ve un glifo de archivo o carpeta -->
        <DataTemplate x:Key="MediumIconsTemplate">
            <StackPanel Width="108" ToolTip="{Binding FullPath}">
                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="48" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Image Source="{Binding MediumThumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           TextAlignment="Center" MaxHeight="34" Margin="0,4,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding MediumThumbnail}" Value="{x:Null}">
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE8B7;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="Goldenrod" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="LargeIconsTemplate">
            <StackPanel Width="204" ToolTip="{Binding FullPath}">
                <Grid Width="192" Height="192" HorizontalAlignment="Center">
                    <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="96" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Image Source="{Binding LargeThumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           TextAlignment="Center" MaxHeight="34" Margin="0,4,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding LargeThumbnail}" Value="{x:Null}">
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE8B7;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="Goldenrod" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Buscar en:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Grid Grid.Column="1">
                <TextBox x:Name="RootBox" Padding="4,3" VerticalContentAlignment="Center"
                         TextChanged="RootBox_TextChanged" KeyDown="RootBox_KeyDown"
                         LostKeyboardFocus="RootBox_LostKeyboardFocus" />
                <TextBlock x:Name="RootPlaceholder" Text="Todas las unidades" Foreground="Gray"
                           Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <Button Grid.Column="2" Content="..." Width="32" Margin="6,0,0,0"
                    ToolTip="Elegir carpeta raiz" Click="BrowseRoot_Click" />
            <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Width="32" Margin="6,0,0,0"
                    ToolTip="Buscar en todas las unidades" Click="ClearRoot_Click" />
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <!-- Mismo orden que el enum SizeMode -->
                <ComboBox x:Name="SizeBox" Width="150" Margin="8,0,0,0" SelectedIndex="0"
                          VerticalContentAlignment="Center" ToolTip="Tamaño" SelectionChanged="SizeBox_SelectionChanged">
                    <ComboBoxItem Content="Cualquier tamaño" />
                    <ComboBoxItem Content="Mayor que" />
                    <ComboBoxItem Content="Menor que" />
                    <ComboBoxItem Content="Vacío (0 KB)" />
                </ComboBox>
                <!-- Visible solo con "Mayor que" o "Menor que" -->
                <StackPanel x:Name="SizeValuePanel" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBox x:Name="SizeValueBox" Width="60" Margin="4,0,0,0" MaxLength="8" Padding="2,0"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                             ToolTip="Cifra (admite decimales: 1,5)" PreviewTextInput="SizeValueBox_PreviewTextInput"
                             TextChanged="SizeValue_Changed" />
                    <!-- Mismo orden que el enum SizeUnit -->
                    <ComboBox x:Name="SizeUnitBox" Width="55" Margin="4,0,0,0" SelectedIndex="1"
                              VerticalContentAlignment="Center" ToolTip="Unidad" SelectionChanged="SizeValue_Changed">
                        <ComboBoxItem Content="KB" />
                        <ComboBoxItem Content="MB" />
                        <ComboBoxItem Content="GB" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
            <!-- Mismo orden que el enum ViewMode -->
            <ComboBox x:Name="ViewBox" Grid.Column="4" Width="135" Margin="8,0,0,0" SelectedIndex="0"
                      VerticalContentAlignment="Center" ToolTip="Vista" SelectionChanged="ViewBox_SelectionChanged">
                <ComboBoxItem Content="Detalles" />
                <ComboBoxItem Content="Iconos medianos" />
                <ComboBoxItem Content="Iconos grandes" />
            </ComboBox>
            <!-- Mismo orden que el enum DatePreset -->
            <ComboBox x:Name="DateBox" Grid.Column="2" Width="160" Margin="8,0,0,0" SelectedIndex="0"
                      VerticalContentAlignment="Center" ToolTip="Fecha de modificacion"
                      SelectionChanged="DateBox_SelectionChanged">
                <ComboBoxItem Content="Cualquier fecha" />
                <ComboBoxItem Content="Hoy" />
                <ComboBoxItem Content="Ayer" />
                <ComboBoxItem Content="Esta semana" />
                <ComboBoxItem Content="La semana pasada" />
                <ComboBoxItem Content="Este mes" />
                <ComboBoxItem Content="El mes pasado" />
                <ComboBoxItem Content="Este año" />
                <ComboBoxItem Content="El año pasado" />
                <ComboBoxItem Content="Rango personalizado..." />
            </ComboBox>
            <CheckBox x:Name="SystemBox" Grid.Column="5" Content="Sistema" Margin="10,0,0,0" VerticalAlignment="Center"
                      ToolTip="Incluir archivos ocultos de sistema (System Volume Information, $Recycle.Bin, desktop.ini...)"
                      Click="SystemBox_Click" />
            <TextBox x:Name="QueryBox" FontSize="15" Padding="6,4,34,4" VerticalContentAlignment="Center"
                     TextChanged="QueryBox_TextChanged" PreviewKeyDown="QueryBox_PreviewKeyDown"
                     ToolTip="linkin mp3 : contiene ambas palabras&#10;&quot;linkin park&quot; : texto exacto&#10;*.mp3, foto_??.jpg : comodines contra el nombre completo&#10;!temp : excluye" />
            <TextBlock x:Name="QueryPlaceholder" Text="Escribe para buscar...   (varias palabras, *.mp3, !excluir)" Foreground="Gray" FontSize="15"
                       Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            <!-- Boton de busquedas recientes, dentro del campo a la derecha -->
            <Button x:Name="HistoryButton" Content="&#xE81C;" FontFamily="Segoe MDL2 Assets" Width="30" Margin="0,2,2,2"
                    HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="Búsquedas recientes (↓ con el campo vacío)" Click="HistoryButton_Click" />

            <!-- Busquedas recientes: Enter o clic restaura, Shift+Supr borra, Esc cierra -->
            <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=QueryBox}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True"
                   Width="{Binding ActualWidth, ElementName=QueryBox}">
                <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="Gray" BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="6,4">
                            <Button Content="Borrar historial" DockPanel.Dock="Right" Padding="8,2" Click="ClearHistory_Click" />
                            <CheckBox x:Name="HistoryEnabledBox" Content="Guardar historial" VerticalAlignment="Center"
                                      Click="HistoryEnabledBox_Click" />
                        </DockPanel>
                        <TextBlock x:Name="HistoryEmpty" DockPanel.Dock="Top" Margin="8,6" Foreground="Gray"
                                   Text="Las búsquedas aparecen aquí cuando abres, copias o arrastras un resultado." TextWrapping="Wrap" />
                        <ListBox x:Name="HistoryList" MaxHeight="320" BorderThickness="0"
                                 MouseUp="HistoryList_MouseUp" KeyDown="HistoryList_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Popup>
            <ComboBox x:Name="KindBox" Grid.Column="1" Width="110" Margin="8,0,0,0" SelectedIndex="0"
                      VerticalContentAlignment="Center" SelectionChanged="KindBox_SelectionChanged">
                <!-- Mismo orden que el enum EntryKind -->
                <ComboBoxItem Content="Todo" />
                <ComboBoxItem Content="Archivos" />
                <ComboBoxItem Content="Carpetas" />
                <ComboBoxItem Content="Imágenes" />
                <ComboBoxItem Content="Videos" />
                <ComboBoxItem Content="Música" />
                <ComboBoxItem Content="Documentos" />
            </ComboBox>
        </Grid>

        <!-- Visible solo con "Rango personalizado..." -->
        <StackPanel x:Name="CustomDatePanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,8"
                    HorizontalAlignment="Right" Visibility="Collapsed">
            <TextBlock Text="Modificado desde" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker x:Name="FromDate" Width="130" SelectedDateChanged="CustomDate_Changed" />
            <TextBlock Text="hasta" VerticalAlignment="Center" Margin="10,0,6,0" />
            <DatePicker x:Name="ToDate" Width="130" SelectedDateChanged="CustomDate_Changed" />
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Indexando unidades NTFS..." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ResultText" />
            </StatusBarItem>
        </StatusBar>

        <!-- IsTextSearchEnabled en falso: con cientos de miles de filas la busqueda por tecla es muy lenta -->
        <ListView x:Name="ResultsList" SelectionMode="Extended" IsTextSearchEnabled="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  KeyDown="ResultsList_KeyDown" GridViewColumnHeader.Click="ColumnHeader_Click"
                  PreviewMouseLeftButtonDown="ResultsList_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="ResultsList_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!-- Stretch para poder alinear a la derecha la columna de tamano -->
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <EventSetter Event="MouseDoubleClick" Handler="ResultItem_DoubleClick" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="_Abrir" InputGestureText="Enter" Click="OpenMenu_Click" />
                    <MenuItem Header="Abrir _carpeta contenedora" InputGestureText="Ctrl+Enter" Click="ShowInFolderMenu_Click" />
                    <MenuItem Header="_Buscar solo aqui" ToolTip="Usar esta carpeta como raiz de las busquedas" Click="SearchHereMenu_Click" />
                    <Separator />
                    <MenuItem Header="Copiar _ruta completa" InputGestureText="Ctrl+C" Click="CopyPathMenu_Click" />
                    <MenuItem Header="Copiar _nombre" Click="CopyNameMenu_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="NameColumn" Header="Nombre" Width="340">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Icono real del tipo de archivo; mientras carga, un glifo generico -->
                                    <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;"
                                                   Foreground="Gray" Visibility="Collapsed" />
                                        <Image Source="{Binding SmallIcon}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding SmallIcon}" Value="{x:Null}">
                                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                        <Setter TargetName="Glyph" Property="Text" Value="&#xE8B7;" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="Goldenrod" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="FolderColumn" Header="Carpeta" Width="540" DisplayMemberBinding="{Binding DirectoryPath}" />
                    <!-- El tamano y la fecha llegan despues que el resto de la fila (ResultRow notifica el cambio) -->
                    <GridViewColumn x:Name="SizeColumn" Header="Tamaño" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding Size, Converter={StaticResource SizeConverter}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ModifiedColumn" Header="Modificado" Width="130"
                                    DisplayMemberBinding="{Binding Modified, StringFormat=yyyy-MM-dd HH:mm}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
